set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(KINDLE_TOOLCHAIN /sdk/x-tools/arm-kindlehf-linux-gnueabihf)
set(CMAKE_C_COMPILER ${KINDLE_TOOLCHAIN}/bin/arm-kindlehf-linux-gnueabihf-gcc)
set(CMAKE_CXX_COMPILER ${KINDLE_TOOLCHAIN}/bin/arm-kindlehf-linux-gnueabihf-g++)
set(CMAKE_SYSROOT ${KINDLE_TOOLCHAIN}/arm-kindlehf-linux-gnueabihf/sysroot)
set(CMAKE_C_FLAGS_INIT "-march=armv7-a -mfpu=neon -mfloat-abi=hard")
set(CMAKE_CXX_FLAGS_INIT "-march=armv7-a -mfpu=neon -mfloat-abi=hard")
# Keep application dependency prefixes passed by the parent build.
list(APPEND CMAKE_FIND_ROOT_PATH ${CMAKE_SYSROOT} /sdk/qt /sdk/fbink /sdk/runtime /sdk/openssl)
list(REMOVE_DUPLICATES CMAKE_FIND_ROOT_PATH)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
